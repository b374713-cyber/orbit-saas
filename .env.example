# ============================================
# ORBIT - Environment Variables (Example)
# ============================================
# Copy this file to `.env` and fill in real values.
# For backend-only vars: copy to `backend/.env`
# For frontend-only vars: copy to `frontend/.env`
# ============================================

# ============================================
# PostgreSQL (for docker-compose.prod.yml)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=collab

# ============================================
# Database Connection
# ============================================
# For local dev (without Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collab?schema=public"
# For Docker:
DATABASE_URL="postgresql://postgres:your-strong-password-here@postgres:5432/collab?schema=public"

# ============================================
# JWT Authentication
# ============================================
# Generate secure secrets: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Server
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Gmail (for email invitations)
# Setup: https://myaccount.google.com/apppasswords
# ============================================
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================
# Groq AI (for AI features)
# Get key: https://console.groq.com/keys
# ============================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# ============================================
# URLs
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000